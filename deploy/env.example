# AlfaDigi ERP — VPS Environment Template
# Copy to: /var/www/alfadigi/server/.env  (phir values edit karo)

# Strong secret — VPS pe naya generate karo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=YAHAN_NAYA_STRONG_SECRET_DAALO

PORT=5000

# VPS ka local MongoDB (same machine)
MONGODB_URI=mongodb://127.0.0.1:27017/erp_alfadigi
